# Configuracion de Entorno - Sistema Reposicion y Ordenes de Compra
# Puerto HTTP
PUERTO=3000
HOST=0.0.0.0

# Base de datos PostgreSQL
# Para entorno local o nube (Supabase / Neon / Render)
URL_BASE_DATOS=postgresql://postgres:postgres@localhost:5555/reposicion_oc
LIMITE_CONEXIONES_POOL=5
TIEMPO_MAXIMO_ESPERA_CONEXION_MS=5000

# Seguridad y Autenticacion JWT
CLAVE_SECRETA_JWT=clave_secreta_super_segura_para_desarrollo_cambiar_en_produccion_2026!
TIEMPO_EXPIRACION_TOKEN_ACCESO=15m
TIEMPO_EXPIRACION_TOKEN_REFRESCO=7d
ENTORNO=desarrollo

# Politicas de Bloqueo
MAXIMO_INTENTOS_FALLIDOS_LOGIN=5
MINUTOS_BLOQUEO_CUENTA=15
MINUTOS_INACTIVIDAD_PROVEEDOR=45
